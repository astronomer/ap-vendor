{# https://circleci.com/docs/2.0/building-docker-images/#docker-version #}
---
version: 2.1

setup: true

orbs:
  path-filtering: circleci/path-filtering@3.0.0 # https://circleci.com/developer/orbs/orb/circleci/path-filtering

parameters:
  overwrite_tags:
    type: boolean
    default: false
    description: "Set True if you want to overwrite existing docker image tag."

workflows:
  version: 2.1
  prek-and-generate-config:
    jobs:
      # Dynamic Configurations can only have one base workflow, so prek has to be in this workflow since it doesn't fit into the path-filtering workflow.
      # https://support.circleci.com/hc/en-us/articles/360060934851-Troubleshooting-Error-Message-Max-number-of-workflows-exceeded
      - run_prek
      - path-filtering/filter:
          base-revision: main
          config-path: .circleci/continue-config.yml
          mapping: |
{%- for directory in directories %}
            {{ directory }}/.* {{ directory }} true
{%- endfor %}

jobs:
  run_prek:
    resource_class: small
    docker:
      - image: quay.io/astronomer/ci-pre-commit:{{ ci_runner_version }}
    steps:
      - checkout
      - run:
          name: Create prek-cache-key.txt
          command: |
            cat uv.lock .pre-commit-config.yaml > /tmp/prek-cache-key.txt
      - restore_cache:
          keys:
            - prek-cache-{{ '{{' }} checksum "/tmp/prek-cache-key.txt" }}
      - run:
          name: Install prek hooks
          command: prek install-hooks
      - save_cache:
          key: prek-cache-{{ '{{' }} checksum "/tmp/prek-cache-key.txt" }}
          paths:
            - ~/.cache/prek
      - run:
          name: Run prek
          command: prek run --all-files --show-diff-on-failure
